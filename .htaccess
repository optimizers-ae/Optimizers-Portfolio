Options -MultiViews
RewriteEngine On

# 1. Do NOT rewrite requests for existing files (CSS, JS, images, fonts, etc.) or directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. Exclude assets directory explicitly
RewriteRule ^assets/ - [L]
RewriteRule ^admin/assets/ - [L]

# 3. Keep clean admin entry points on the admin shell
RewriteRule ^admin/?$ admin/index.php [L,QSA]
RewriteRule ^admin/(index|cases|services|settings)/?$ admin/index.php [L,QSA]

# 4. Case Study detail page (/case-studies/example-slug or /case-study/example-slug)
RewriteRule ^case-studies/([a-zA-Z0-9_-]+)/?$ case-study.php?slug=$1 [L,QSA]
RewriteRule ^case-study/([a-zA-Z0-9_-]+)/?$ case-study.php?slug=$1 [L,QSA]

# 5. Case Studies archive page (/case-studies or /case-studies/)
RewriteRule ^case-studies/?$ case-studies.php [L,QSA]

# 6. Service detail page (/services/example-slug or /service/example-slug)
RewriteRule ^services/([a-zA-Z0-9_-]+)/?$ service.php?slug=$1 [L,QSA]
RewriteRule ^service/([a-zA-Z0-9_-]+)/?$ service.php?slug=$1 [L,QSA]

# 7. Services archive page (/services or /services/)
RewriteRule ^services/?$ index.php#services [L,QSA]

# 8. Fallback all non-file requests to index.php (which handles front-routing)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]
